rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User collection rules
    match /users/{userId} {
      allow read, write: if true; // In production, restrict to authenticated users
    }
    
    // Medicines and Inventory collection rules
    match /medicines/{medicineId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'manager');
    }
    match /inventory/{inventoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'manager' || request.auth.token.role == 'pharmacist');
    }
    
    // Sales collection rules
    match /sales/{saleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'pharmacist');
    }
    
    // Suppliers collection rules
    match /suppliers/{supplierId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.token.role == 'admin' || request.auth.token.role == 'manager');
    }
    
    // Forecasts collection rules
    match /forecasts/{forecastId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Audit logs rules
    match /audit_logs/{logId} {
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }
  }
}
